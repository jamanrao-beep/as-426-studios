# Copy these into your hosting panel's environment variables. Never commit real values.

# REQUIRED in production: a long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Hostinger MySQL (when all four are set, the app uses MySQL instead of the local test database)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional: only used when running the seed/migration scripts
SEED_SUPER_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_WAITER_PASSWORD=

# Local development only (ignored when MySQL is configured): creates one Super Admin in the local test database
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Email from the Table Secret Gmail account (approval emails and guest verification codes).
# MAIL_PASS must be a Gmail "App password" (Google Account > Security > 2-Step Verification > App passwords), never the normal password.
MAIL_USER=as426.studios@gmail.com
MAIL_PASS=
# Optional: MAIL_FROM_NAME=Table Secret
