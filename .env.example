# Copy these into your hosting panel's environment variables. Never commit real values.

# REQUIRED in production: a long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Hostinger MySQL (when all four are set, the app uses MySQL instead of the local test database)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional: only used when running the seed/migration scripts
SEED_SUPER_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_WAITER_PASSWORD=
